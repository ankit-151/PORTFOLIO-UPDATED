# Node modules (all sub-packages)
node_modules/
**/node_modules/

# Environment variables (never commit secrets)
.env
.env.local
.env.production
**/.env
**/.env.local
**/.env.production

# Build outputs
dist/
build/
**/dist/
**/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads (user generated content, not committed)
backend/uploads/*
!backend/uploads/.gitkeep

# Typescript build info
*.tsbuildinfo
